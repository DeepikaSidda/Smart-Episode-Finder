# Only needed to run the agent locally (serverless/agent/demo.py).
# The deployed Lambdas get these from their own environment config in
# serverless/infra/env-*.json, and read the YouTube key from SSM Parameter Store.

# YouTube Data API v3 key.
# In AWS this is NOT set here - it lives in SSM at the path below.
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_API_KEY_PARAM=/smart-podcast-finder/youtube_api_key

# S3 bucket holding job state and saved transcripts.
JOBS_BUCKET=spf-jobs-414691912352

# Bedrock model that scores and ranks episode content.
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0
BEDROCK_REGION=us-east-1

# Bedrock model that drives the Strands agent loop and picks the tools.
AGENT_MODEL_ID=us.amazon.nova-2-lite-v1:0
